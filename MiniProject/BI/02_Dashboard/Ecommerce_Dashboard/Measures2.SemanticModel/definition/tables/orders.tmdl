table orders
	lineageTag: bf14d01b-4373-4ab6-bc9f-476580c7500e

	measure 'Late Delivery Rate' =
			
			DIVIDE(
			    SUM(Orders[is_late]),
			    COUNT(Orders[is_late])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 886c2460-d7e5-4606-93db-9dfe639aa324

	measure 'Late Orders' = ```
			SUM(Orders[is_late])
			
			```
		formatString: 0
		lineageTag: fa15f2ae-6c0f-482e-b83b-13f55adbb3cf

	measure 'On-time Rate' = ```
			1 - [Late Delivery Rate]
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 26eac189-e5a3-4df7-a613-0f01584d81cc

	measure Orders = DISTINCTCOUNT(Order_items[order_id])
