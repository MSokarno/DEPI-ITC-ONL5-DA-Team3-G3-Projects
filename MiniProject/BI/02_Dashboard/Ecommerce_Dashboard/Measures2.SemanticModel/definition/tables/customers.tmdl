		annotation SummarizationSetBy = Automatic

	column customer_city
		dataType: string
		lineageTag: 251996ee-ae1b-4122-b3b0-ffc0d7507211
		dataCategory: Uncategorized
		summarizeBy: none
		sourceColumn: customer_city

		annotation SummarizationSetBy = Automatic

	column customer_state
		dataType: string
		lineageTag: ba58a330-f312-4b19-809c-63ab23508e45
