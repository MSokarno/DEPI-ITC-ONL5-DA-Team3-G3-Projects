	column 'Order Date' =
			
			DATE (
			    YEAR ( orders[order_purchase_timestamp] ),
			    MONTH ( orders[order_purchase_timestamp] ),
			    DAY ( orders[order_purchase_timestamp] )
			)
		formatString: yyyy
		lineageTag: ccc5af55-7e8a-45b8-a495-958ba608efaa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column is_late =
			
			IF(
			    NOT ISBLANK(Orders[order_delivered_customer_date]),
			    IF(
			        Orders[order_delivered_customer_date] > Orders[order_estimated_delivery_date],
			        1,
			        0
			    )
			)
		formatString: 0
		lineageTag: 5094f111-645b-498c-9f4f-0996e5e6e4bd
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Delivery Status' =
			
			IF(ISBLANK(Orders[is_late]), BLANK(), IF(Orders[is_late] = 1, "Late", "On time"))
		lineageTag: 71b3bf4f-6e6e-4ff0-b689-52cf5b1e97c6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

