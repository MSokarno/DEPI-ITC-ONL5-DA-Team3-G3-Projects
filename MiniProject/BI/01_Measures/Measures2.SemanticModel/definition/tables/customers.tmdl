table customers
	lineageTag: 9a8ccce3-e3c4-4f48-bdf8-9bd6a69b9a1a

	measure 'Total Sales' =
			
			CALCULATE (
			    SUMX ( order_items, order_items[quantity] * order_items[unit_price] ),
			    orders[order_status] = "delivered"
			)
		lineageTag: c43aa29c-3800-475e-a801-32cc4d3b2a6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delivered Orders' =
			
			CALCULATE (
			    DISTINCTCOUNT ( orders[order_id] ),
			    orders[order_status] = "delivered"
			)
		formatString: 0
		lineageTag: cc1ffc67-46e0-4061-9f17-0bc2a5d9b6b2

	measure 'Freight Value' =
			
			CALCULATE (
			    SUMX ( order_items, order_items[quantity] * order_items[unit_freight_value] ),
			    orders[order_status] = "delivered"
			)
		lineageTag: 359eaeb3-28dc-43e4-8f1f-dfba5f898933

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' = [Total Sales] + [Freight Value]
		lineageTag: dc97d042-3b66-4fb4-85d1-aa1b56d46f28

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Order Value' = DIVIDE ( [Total Sales], [Delivered Orders] )
		formatString: 0.00
		lineageTag: 865a89dd-0d1e-411c-b1e9-99703e876121

	measure 'Cancellation Rate' =
			
			DIVIDE (
			    CALCULATE ( DISTINCTCOUNT ( orders[order_id] ), orders[order_status] = "canceled" ),
			    DISTINCTCOUNT ( orders[order_id] )
			)
		lineageTag: 3b011454-f064-4c63-8166-3d3e6186420c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

