		summarizeBy: none
		sourceColumn: customer_state

		annotation SummarizationSetBy = Automatic

	column Country = "Brazil"
		lineageTag: 563ea76d-0aa2-4432-927a-bdc475527e0d
		dataCategory: Country
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition customers = m
		mode: import
