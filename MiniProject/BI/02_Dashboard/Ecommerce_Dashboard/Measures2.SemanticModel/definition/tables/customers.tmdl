				let
				    Source = Excel.Workbook(File.Contents("C:\Users\Admin\Downloads\Mini Project\After\ecommerce_cleaned.xlsx"), null, true),
				    clean_customers_Sheet = Source{[Item="clean_customers",Kind="Sheet"]}[Data],
				    #"Promoted Headers" = Table.PromoteHeaders(clean_customers_Sheet, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"customer_id", type text}, {"customer_unique_id", type text}, {"customer_zip_code_prefix", Int64.Type}, {"customer_city", type text}, {"customer_state", type text}, {"geolocation_zip_code_prefix", Int64.Type}, {"geolocation_city", type text}, {"geolocation_state", type text}, {"city_check", type text}, {"state_check", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"geolocation_zip_code_prefix", "geolocation_city", "geolocation_state", "city_check", "state_check"})
				in
